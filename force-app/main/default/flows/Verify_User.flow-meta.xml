<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Assign isVerified to True and set a response.</description>
        <name>Invalid_OTP_By_User</name>
        <label>Invalid OTP By User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>isVerified</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ResponseMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Incorrect OTP, user is not authorized.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Assign isVerified to True and set a response.</description>
        <name>Valid_OTP_By_User</name>
        <label>Valid OTP By User</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>isVerified</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>ResponseMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>User is Authorized.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Check if userKey matches with the authenticationKey</description>
        <name>Check_Match</name>
        <label>Check Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Invalid_OTP_By_User</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Match False</defaultConnectorLabel>
        <rules>
            <name>Match_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>userKey</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>authenticationKey</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Valid_OTP_By_User</targetReference>
            </connector>
            <label>Match True</label>
        </rules>
    </decisions>
    <description>This flow is used to verify the user by matching the userKey with the authentication key</description>
    <environments>Default</environments>
    <interviewLabel>Verify User {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Verify User</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Match</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>Verification Code generated by the apex class</description>
        <name>authenticationKey</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>isVerified</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <description>Authentication Message</description>
        <name>ResponseMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Verification Provided by the user.</description>
        <name>userKey</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
