<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Individual_Record_ID</name>
        <label>Add Individual Record ID</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>SourceIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_over_junction_record.SourceRecordId__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_over_junction_record</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Customer_Not_found</name>
        <label>Customer Not found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>policySummaries</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Customer Not Found, Please provide correct Name</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>No_Data_Found</name>
        <label>No Data Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>PersonName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Unified_Individual.ssot__PersonName__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>hasmarketingData</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Send_Marketing_Data</name>
        <label>Send Marketing Data</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>CustomerName</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Unified_Individual.ssot__PersonName__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>hasmarketingData</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>emailConsentStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Marketing_Consent.EmailConsent__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>phoneConsentStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Marketing_Consent.Phone_Consent__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>emailsSent</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Marketing_Consent.EmailsSent__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>emailsClicked</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Marketing_Consent.EmailsClicked__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>emailsOpened</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Marketing_Consent.EmailsOpened__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>lastEngagementDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Marketing_Consent.LastEngagementDate__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Customer_Found</name>
        <label>Check Customer Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Identity_Links</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Found</defaultConnectorLabel>
        <rules>
            <name>Not_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Unified_Individual</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Customer_Not_found</targetReference>
            </connector>
            <label>Not Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Marketing_Data_Found</name>
        <label>Check Marketing Data Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Send_Marketing_Data</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Found Data</defaultConnectorLabel>
        <rules>
            <name>Not_exist</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Marketing_Consent</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>No_Data_Found</targetReference>
            </connector>
            <label>Not exist</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Assess Outreach Eligibility By Name Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Assess Outreach Eligibility By Name Flow</label>
    <loops>
        <name>Loop_over_junction_record</name>
        <label>Loop over junction record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Identity_Links</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Individual_Record_ID</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Marketing_Consent</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Identity_Links</name>
        <label>Get Identity Links</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_over_junction_record</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>UnifiedRecordId__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Unified_Individual.ssot__Id__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>IndividualIdentityLink__dlm</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Marketing_Consent</name>
        <label>Get Marketing Consent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Marketing_Data_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SubscriberId__c</field>
            <operator>In</operator>
            <value>
                <elementReference>SourceIds</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Marketing_Engagement__dlm</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Unified_Individual</name>
        <label>Get Unified Individual</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Customer_Found</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>ssot__FirstName__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>CustomerName</elementReference>
            </value>
        </filters>
        <filters>
            <field>ssot__PersonName__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>CustomerName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>UnifiedIndividual__dlm</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Unified_Individual</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>The first Name or The full name of The customer</description>
        <name>CustomerName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Raw email consent status: exactly one of Opted-In, Opted-Out, or No Data</description>
        <name>emailConsentStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Number of those emails clicked</description>
        <name>emailsClicked</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Number of those emails opened</description>
        <name>emailsOpened</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Number of marketing emails sent to this customer, if on the email channel</description>
        <name>emailsSent</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>If there is any Marketing data avaialble</description>
        <name>hasmarketingData</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Date of the customer&apos;s last marketing engagement</description>
        <name>lastEngagementDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>The Full name of The Customer</description>
        <name>PersonName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Raw phone consent status: exactly one of Opted-In, Opted-Out, or No Data</description>
        <name>phoneConsentStatus</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>policySummaries</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>SourceIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
